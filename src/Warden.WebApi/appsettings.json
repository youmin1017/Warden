{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=warden.db"
  },
  "Jwt": {
    "Issuer": "Warden",
    "Audience": "Warden.Client",
    "SigningKey": "dev-only-signing-key-replace-with-32-plus-random-bytes-in-prod",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "SeedAdmin": {
    "Email": "admin@warden.local",
    "DisplayName": "Administrator"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Oidc": {
    "FrontendBaseUrl": "http://localhost:3000",
    "Providers": []
  }
}
