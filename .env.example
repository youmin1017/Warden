# Frontend (frontend/.env) — overrides nuxt.config.ts runtimeConfig.public.apiBase
NUXT_PUBLIC_API_BASE=http://localhost:5083

# Backend — these map to appsettings.json via ASP.NET Core's env var configuration provider
# (double underscore = nested key separator), only needed if you want to override appsettings.json.
# ASPNETCORE_ENVIRONMENT=Development
# Database__Provider=Sqlite
# ConnectionStrings__Default=Data Source=warden.db
# Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-bytes
# SeedAdmin__Email=admin@warden.local

# OIDC — at least 1 providers required; each needs its redirect URI
# ({ApiBase}/api/auth/callback/{Name}) registered in that provider's own console.
# Oidc__FrontendBaseUrl=http://localhost:3000
# Oidc__Providers__0__Name=azuread
# Oidc__Providers__0__DisplayName=Microsoft
# Oidc__Providers__0__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
# Oidc__Providers__0__ClientId=replace-me
# Oidc__Providers__0__ClientSecret=replace-me

# docker-compose Postgres service — matches docker-compose.yml defaults
POSTGRES_DB=warden
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
