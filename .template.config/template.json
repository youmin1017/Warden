{
  "$schema": "http://json.schemastore.org/template",
  "author": "Warden template",
  "classifications": ["Web", "RBAC", "Admin", "Nuxt"],
  "identity": "Warden.FullstackAdminTemplate",
  "name": "Fullstack .NET + Nuxt Admin (RBAC) Template",
  "shortName": "warden",
  "sourceName": "Warden",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "lowerSourceName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "casing": "LowerCase"
      },
      "replaces": "warden",
      "fileRename": "warden"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        ".git/**",
        ".claude/**",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "**/.nuxt/**",
        "**/.output/**",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal",
        "**/.vs/**"
      ]
    }
  ]
}
